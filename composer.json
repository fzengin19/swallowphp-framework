{
    "name": "swallowphp/framework",
    "version": "1.2.0",
    "description": "Swallow PHP framework",
    "type": "library",
    "keywords": [
        "SwallowPHP",
        "framework"
    ],
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "SwallowPHP\\Framework\\": "src/"
        },
        "files": [
            "src/Methods.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Fatih Zengin",
            "email": "fatihzengin654@outlook.com"
        }
    ],
    "minimum-stability": "dev",
    "prefer-stable": true,
    "require": {
        "phpmailer/phpmailer": "^6.9.1",
        "php-debugbar/php-debugbar": "^1.23",
        "psr/simple-cache": "^3.0",
        "league/container": "^4.2"
    },
    "require-dev": {
        "pestphp/pest": "^4.3"
    },
    "scripts": {
        "test": "./vendor/bin/pest"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    }
}
